---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="TinyAttention">
  <main class="mx-auto max-w-2xl px-4 py-16">
    <h1 class="text-4xl font-bold">TinyAttention</h1>
    <p class="mt-4" style="color: var(--muted)">
      A real, synthesizable FlashAttention engine in SystemVerilog, compiled to WebAssembly and
      running live in your browser. Under construction.
    </p>
    <p class="mt-8">
      <a class="underline" style="color: var(--accent)" href="/spike">Toolchain spike &rarr;</a>
    </p>
  </main>
</Layout>
